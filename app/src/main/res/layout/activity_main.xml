<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:text="DeltaForce 助手" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="原生 Android · 清晰界面 · 连接你的 API" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/baseUrl" android:hint="API 地址，例如 https://example.com/" android:inputType="textUri" android:singleLine="true" android:layout_marginTop="18dp" android:background="@android:drawable/editbox_background" android:padding="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
<Button android:id="@+id/saveUrl" android:text="保存 API 地址" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="50dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/qq" android:text="QQ 登录" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
<Button android:id="@+id/wechat" android:text="微信登录" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
<Button android:id="@+id/wegame" android:text="WeGame" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
<Button android:id="@+id/pioneer" android:text="Pioneer" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
<Button android:id="@+id/qqsafe" android:text="QQSafe" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
<Button android:id="@+id/test" android:text="接口测试" android:layout_weight="1" android:layout_width="0dp" android:layout_height="50dp"/>
</LinearLayout>
<ImageView android:id="@+id/qr" android:visibility="gone" android:contentDescription="登录二维码" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:layout_width="260dp" android:layout_height="260dp"/>
<TextView android:id="@+id/status" android:text="请先填写 API 地址" android:textSize="15sp" android:textColor="@color/text" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/jsonInput" android:hint="需要参数的功能可在这里输入 JSON，例如 &quot;id&quot; 和 &quot;ticket&quot;" android:gravity="top" android:inputType="textMultiLine" android:minLines="4" android:layout_marginTop="12dp" android:padding="12dp" android:layout_width="match_parent" android:layout_height="120dp"/>
<TextView android:id="@+id/result" android:text="" android:textSize="13sp" android:textColor="@color/text" android:fontFamily="monospace" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
